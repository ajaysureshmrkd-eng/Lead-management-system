
# api call for admin register create account
###
POST http://127.0.0.1:8000/accounts/admin/
Content-Type: application/json

{
    "username":"admin_01",
    "email":"admin@gmail.com",
    "password":"admin@123",
    "phone":"9767875544"
}

# api call for user register create account
###
POST http://127.0.0.1:8000/accounts/user/
Content-Type: application/json

{
    "username":"user_01",
    "email":"user@gmail.com",
    "password":"user@123",
    "phone":"876394855"
}


# api call for jwt access create
###
POST http://127.0.0.1:8000/accounts/user/token/
Content-Type: application/json

{
    "username":"user_01",
    "password":"user@123"
}

